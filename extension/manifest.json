{
  "manifest_version": 3,
  "name": "VNSO CloudStack Quick Actions",
  "version": "1.0.0",
  "description": "Quick actions for VNSO CloudStack: list/start/stop VMs, copy API endpoints, jump to Service Catalog.",
  "minimum_chrome_version": "110",
  "permissions": ["storage", "clipboardWrite", "notifications"],
  "host_permissions": ["https://*/*", "http://localhost/*"],
  "action": {
    "default_title": "VNSO CloudStack",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
