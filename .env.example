# VNSO CloudStack runtime environment template
# Copy to .env, fill real secrets, and never commit .env.

# Management/API endpoints
CLOUDSTACK_MGMT_IP=103.9.157.6
CLOUDSTACK_PUBLIC_URL=https://cloudstack.vnso.vn
CLOUDSTACK_API_URL=http://103.9.157.6:28080/client/api/

# CloudStack admin login used by local smoke/verification scripts.
# These values are injected from .env or CI/CD secrets. Do not hardcode them in docs or source.
CLOUDSTACK_ADMIN_USER=
CLOUDSTACK_ADMIN_PASS=
CLOUDSTACK_ADMIN_DOMAIN=

# KVM host access used only by operator verification scripts.
KVM_ROOT_USER=root
KVM_ROOT_PASSWORD=
CLOUDSTACK_KVM_HOSTS="103.9.159.151 103.9.159.165 103.9.159.188"

# Database/container settings.
DB_CONTAINER=xiaozhi-esp32-server-db
DB_HOST=xiaozhi-esp32-server-db
DB_PORT=3306
DB_NAME=cloud
DB_USER=cloud
DB_PASS=
DB_PASSWORD=
DB_BACKUP_DIR=/var/backups/cloudstack

# Compose/runtime tuning.
JAVA_TOOL_OPTIONS="--add-opens=java.base/java.lang=ALL-UNNAMED -Xms512m -Xmx2048m -Dlog4j.configurationFile=/opt/cloudstack/conf/log4j-cloud.xml"
TZ=Asia/Ho_Chi_Minh
